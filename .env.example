# Connexion Postgres (docker-compose expose le port 5433 en local)
DATABASE_URL=postgresql://hackstack:hackstack@localhost:5433/hackstack

# Chemins des dumps SQLite existants à importer (Étape 1)
SQLITE_HACKATHONS=/home/mehdi/Projects/hackathon/hackathons.db
SQLITE_ETHGLOBAL=/home/mehdi/Projects/hackathon/ethglobal.db

# Modèle d'embeddings (pipeline Étape 1 + encodage des requêtes /search Étape 3).
# Ne pas changer sans ré-encoder les 21k projets : les vecteurs stockés et les vecteurs de
# requête doivent venir du même modèle.
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=32

# Backend d'encodage des requêtes /search :
#   local  (défaut) — charge bge-m3 en mémoire (~2 Go). Pour le dev et un hôte avec RAM.
#   remote          — appelle l'inférence HuggingFace, aucun poids en mémoire (~80 Mo de
#                     RSS au total). Nécessaire pour un hébergement serverless.
EMBED_BACKEND=local

# HuggingFace : requis si EMBED_BACKEND=remote, et pour publier le dataset (Étape 8).
# L'API refuse de démarrer en backend `remote` sans ce token (sinon /search se dégraderait
# silencieusement en full-text).
HF_TOKEN=
# Endpoint d'inférence. À ne changer que pour viser un endpoint auto-hébergé.
HF_INFERENCE_BASE=https://router.huggingface.co/hf-inference

# Déploiement. Tokens personnels, à générer dans les dashboards respectifs.
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# OpenRouter (extraction tech_stack + thèmes par LLM, Étape 4)
OPENROUTER_API_KEY=
# Modèle bon marché à sortie structurée (défaut si vide : google/gemini-2.0-flash-001)
OPENROUTER_MODEL=

# GitHub API (extraction tech_stack fiable, Étape 4). Sans token : 60 req/h (échantillon
# seulement) ; avec token : 5000 req/h (run complet).
GITHUB_TOKEN=
