# Connexion Postgres (docker-compose expose le port 5433 en local)
DATABASE_URL=postgresql://hackstack:hackstack@localhost:5433/hackstack

# Chemins des dumps SQLite existants à importer (Étape 1)
SQLITE_HACKATHONS=/home/mehdi/Projects/hackathon/hackathons.db
SQLITE_ETHGLOBAL=/home/mehdi/Projects/hackathon/ethglobal.db

# Modèle d'embeddings (pipeline Étape 1 + encodage des requêtes /search Étape 3)
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=32

# OpenRouter (extraction tech_stack, Étape 4 — pas utilisé en Étape 1)
OPENROUTER_API_KEY=

# GitHub API (extraction tech_stack fiable, Étape 4 — pas utilisé en Étape 1)
GITHUB_TOKEN=
